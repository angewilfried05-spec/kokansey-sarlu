{
  "name": "kokansey-desktop",
  "version": "1.0.0",
  "description": "Application de bureau KOKANSEY SARLU",
  "main": "electron-main.cjs",
  "type": "commonjs",
  "author": "KOKANSEY SARLU",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.kokansey.desktop",
    "productName": "KOKANSEY SARLU",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron-main.cjs",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
